# Copy to backend/.env and fill in. Never commit the real .env.

# 1 = simulated prices and fills (works on macOS/Linux, no MT5 needed).
# 0 = live MetaTrader 5 terminal (Windows only).
MT5_MOCK=1

# Live mode only: your FundingPips MT5 credentials (from the FundingPips dashboard).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: full path to terminal64.exe if more than one MT5 terminal is installed.
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Liquid symbol whose tick time is used as the MT5 server clock (daily reset). Change if your broker uses suffixes.
SERVER_TIME_SYMBOL=EURUSD

# HTTP server. Loopback only (127.0.0.1, localhost or ::1): reach it from the Mac through an SSH tunnel.
APP_HOST=127.0.0.1
APP_PORT=8000
# Extra browser origins allowed to call the API. Leave unset: mock mode already allows the
# Vite dev server (npm run dev, port 5173), and live mode should allow only the app itself.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Mock mode only
MOCK_SERVER_TZ=Europe/Athens
MOCK_INITIAL_BALANCE=100000

LOG_LEVEL=INFO
